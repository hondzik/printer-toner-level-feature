{
  "author": {
    "name": "Jan Kropáč",
    "email": "honza@kropac.net"
  },
  "license": "MIT",
  "name": "printer-toner-level-feature",
  "displayName": "Printer toner Tile card feature",
  "description": "A Home Assistant Lovelace custom card feature to display printer toner levels",
  "repository": {
    "type": "git",
    "url": "https://github.com/hondzik/printer-toner-level-feature"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "feature",
    "printer",
    "toner",
    "ink"
  ],
  "type": "module",
  "version": "1.2.1",
  "module": "./dist/printer-toner-level-feature.js",
  "scripts": {
    "watch": "rollup -c conf/rollup.config.js -w",
    "build": "rollup -c conf/rollup.config.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint & format": "npm run typecheck && eslint --config conf/eslint.config.js src README.md --ext .ts,.js --fix && prettier --config conf/.prettierrc.json --ignore-path conf/.prettierignore --write src/**/*.{ts,js,json,css,scss,html} && markdownlint-cli2 --config conf/.markdownlint-cli2.jsonc --fix",
    "lint:check": "npm run typecheck && eslint --config conf/eslint.config.js src README.md --ext .ts,.js && prettier --config conf/.prettierrc.json --ignore-path conf/.prettierignore --check src/**/*.{ts,js,json,css,scss,html} && markdownlint-cli2 --config conf/.markdownlint-cli2.jsonc",
    "test": "vitest run",
    "version MAJOR": "npm version major",
    "version MINOR": "npm version minor",
    "version PATCH": "npm version patch",
    "version CUSTOM": "node scripts/version-custom.js"
  },
  "devDependencies": {
    "@eslint/markdown": "^9.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "rollup": "^4.68.7",
    "rollup-plugin-summary": "^3.0.1",
    "tslib": "^2.9.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "custom-card-helpers": "^2.2.1",
    "home-assistant-js-websocket": "^9.8.1",
    "lit": "^3.3.3"
  },
  "overrides": {
    "katex": "^0.19.1"
  }
}
